# ─── Core ────────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgres://heydoc:heydoc@localhost:5433/heydoc
NODE_ENV=development
LOG_LEVEL=info

# ─── WhatsApp Cloud API ──────────────────────────────────────────────────────
# Signature verification is real. Outbound is mocked unless MOCK_WHATSAPP=false.
WHATSAPP_APP_SECRET=dev-app-secret
WHATSAPP_VERIFY_TOKEN=dev-verify-token
MOCK_WHATSAPP=true
# Only needed if MOCK_WHATSAPP=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Lab API ─────────────────────────────────────────────────────────────────
LAB_URL=http://localhost:4000
LAB_TIMEOUT_MS=2000
LAB_SLOTS_TIMEOUT_MS=3000
LAB_MAX_ATTEMPTS=3

# ─── LLM ─────────────────────────────────────────────────────────────────────
# mock = deterministic, zero cost, used by tests and the load run.
# openrouter = real free model. No key? Leave mock.
LLM_PROVIDER=mock
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_FALLBACKS=inclusionai/ling-3.2-flash:free,google/gemma-4-31b-it:free,openrouter/free
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
MAX_LLM_CALLS_PER_DAY=45
MAX_SPEND_USD=2
MAX_AGENT_STEPS=6
MAX_CONVERSATION_TOKENS=20000
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=800

# ─── Behaviour ───────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
JOB_MAX_ATTEMPTS=6
JOB_BACKOFF_BASE_MS=500
JOB_LEASE_SECONDS=90
WORKER_CONCURRENCY=8
POLL_INTERVAL_MS=100

# ─── Demo / ops ──────────────────────────────────────────────────────────────
# /demo, /dev/* and unauthenticated /api/* only when true.
DEV_MODE=true
ADMIN_TOKEN=

# ─── Mock lab (only read by the mock-lab process) ────────────────────────────
LAB_FAIL_RATE=0.2
# mixed | before | after | none
LAB_FAIL_MODE=mixed
LAB_MIN_LATENCY_MS=120
LAB_MAX_LATENCY_MS=700
LAB_SEED=
